{
  "name": "@customer-success/buoy",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --build --incremental",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "test:email-link": "rer queue test:email-link -- sh -c \"node tests/email-link.mjs\"",
    "onboard": "node scripts/install.mjs",
    "build:app": "rer queue build:app -- sh -c \"vite build\"",
    "verify:app": "node scripts/verify-app.mjs",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "outbox": "rer outbox",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:ai": "node --test --test-concurrency=1 --test-name-pattern=\"^AI-00\" tests/flows.test.mjs",
    "test:ai-browser": "node tests/ai-browser.mjs && node tests/communication-browser.mjs",
    "test:flows": "node --test --test-concurrency=1 tests/flows.test.mjs",
    "test:teams": "node tests/teams.mjs",
    "test:notifications": "node tests/notifications.mjs",
    "test:portable": "node tests/portable.mjs",
    "build:site": "rer build --site",
    "test:site": "node tests/site.mjs",
    "test:style": "node tests/style.mjs",
    "test:segments": "node tests/segments.mjs",
    "test:outcomes": "node tests/outcomes.mjs",
    "test:boundary": "node tests/boundary.mjs",
    "test:runway-keyboard": "perl -e 'setpgrp(0,0); exec @ARGV' -- node tests/runway-keyboard.mjs",
    "test:governance": "node tests/governance.mjs",
    "test:governance-browser": "node tests/governance-browser.mjs",
    "test:fields-browser": "node tests/fields-browser.mjs",
    "test:a11y": "node tests/a11y.mjs",
    "test:customer-people-browser": "node tests/customer-people-browser.mjs",
    "test:usage-browser": "node tests/usage-browser.mjs",
    "test:connections": "node tests/connections.mjs",
    "test:connections-browser": "node tests/connections-browser.mjs",
    "test:adoption": "node tests/adoption.mjs",
    "test:adoption-browser": "node tests/adoption-browser.mjs",
    "test:inapp-browser": "node tests/inapp-browser.mjs",
    "test:adoption-consumers": "node tests/adoption-consumers.mjs account",
    "test:adoption-aggregates": "node tests/adoption-consumers.mjs segment",
    "test:health": "node tests/adoption-consumers.mjs health",
    "test:flows:core": "node --test --test-concurrency=1 --test-name-pattern=\"^(Buoy public|HTTP-001 IMPORT-001|AGENT-002|API-001)\" tests/flows.test.mjs",
    "test:records": "node --test --test-concurrency=1 --test-name-pattern=\"^(REVIEW-001|REPORT-002|ACCOUNT-005|ERASE-002|RENEW-001|ACCOUNT-003|ACCOUNT-001|PLAY-001|RENEW-004)\" tests/flows.test.mjs",
    "test:volume": "node --test --test-concurrency=1 --test-name-pattern=\"^(USAGE-001 receiver|TEAM-001 300-account)\" tests/flows.test.mjs",
    "test:records-browser": "node tests/record-browser.mjs",
    "test:privacy-renewal-browser": "node tests/record-browser.mjs privacy-renewals",
    "test:workspace-browser": "node tests/record-browser.mjs workspace",
    "test:hierarchy-browser": "node tests/record-browser.mjs hierarchy",
    "test:roles": "node --test --test-concurrency=1 --test-name-pattern=\"^ROLE-001\" tests/flows.test.mjs",
    "test:roles-browser": "node tests/roles-browser.mjs",
    "test:billing": "node tests/billing-journey.mjs --browser",
    "test:dashboards-browser": "node tests/record-browser.mjs dashboards",
    "test:reviews-browser": "node tests/record-browser.mjs reviews",
    "test:integration-browser": "node tests/integration-journey.mjs --browser",
    "test:plans": "node --test --test-concurrency=1 --test-name-pattern=\"^PLAN-001\" tests/flows.test.mjs",
    "test:plans-browser": "node tests/record-browser.mjs plans",
    "test:migrate": "node --test --test-concurrency=1 tests/migrate-journey.mjs",
    "delivery:spec": "node scripts/build-deployment-spec.mjs",
    "check:deployment-spec": "node scripts/build-deployment-spec.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "hono": "4.13.7",
    "marked": "18.1.1",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.80",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.14.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1",
      "source-map-js": "1.2.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "description": "Customer success and renewals with evidence and person-approved playbooks",
  "license": "MIT",
  "repository": "https://github.com/just-every/run-buoy"
}
